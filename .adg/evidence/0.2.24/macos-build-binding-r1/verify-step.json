"set -euo pipefail\napp=\"apps/desktop/tauri/target/aarch64-apple-darwin/release/bundle/macos/OpenCodeX Desktop.app\"\ncodesign --verify --deep --strict \"$app\"\ncodesign -dvv \"$app\" 2>&1\ntest -s \"$app/Contents/Resources/resources/LICENSE\"\ntest -s \"$app/Contents/Resources/resources/THIRD-PARTY-NOTICES.txt\"\npython3 - <<'PY'\nimport importlib.util, json, os, subprocess\nfrom pathlib import Path\nroot = Path.cwd()\nspec = importlib.util.spec_from_file_location('binding024', root / '.github/scripts/verify_macos_build_024.py')\nbinding = importlib.util.module_from_spec(spec); spec.loader.exec_module(binding)\ndirectory = Path(os.environ['OCXD_TAURI_RETRY_EVIDENCE'])\nattempts = [json.loads(p.read_bytes()) for p in sorted(directory.glob('attempt-*.json'))]\nsuccessful = [row for row in attempts if row['exitCode'] == 0]\nif len(successful) != 1 or successful[0]['stdoutTruncated']:\n    raise ValueError('one complete successful Tauri Cargo receipt is required')\nreceipt = directory / ('attempt-' + str(successful[0]['attempt']) + '.stdout.log')\napp = root / 'apps/desktop/tauri/target/aarch64-apple-darwin/release/bundle/macos/OpenCodeX Desktop.app'\nsource = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\nreport = binding.verify(app, receipt, root / 'apps/desktop/tauri', source)\n(directory / 'macos-build-binding.json').write_text(json.dumps(report, indent=2) + '\\n')\nPY\n"
