{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "OpenCodeX 桌面管理器主窗口默认能力：核心事件订阅（状态快照推送）、标题栏拖拽与受控进程退出。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "process:allow-exit"
  ]
}
