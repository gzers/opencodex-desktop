+import { afterEach, expect, test } from 'bun:test';
+import { windowsDesktopAppAdapter } from '../../src/codex/desktop-app/windows';
+import { listWindowsSnapshots, parseWindowsSnapshotOutput } from '../../src/codex/app-server-processes';
+import { setTrustedWindowsElevationExecutablesForTests } from '../../src/lib/windows-elevation';
+
+const powershell = 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe';
+const root = "C:\\Program Files\\WindowsApps\\Fixture' Unicode 包";
+const install = { id: 'fixture', root, relaunch: 'fixture!App' };
+const stamp = '2026-11-05T08:00:00.1234567Z';
+afterEach(() => setTrustedWindowsElevationExecutablesForTests(null));
+
+test('desktop identity query preserves command-line context through the unchanged parser', () => {
+  setTrustedWindowsElevationExecutablesForTests({ powershell });
+  const commandLine = '"' + root + '\\ChatGPT.exe" --proxy-pac-url=http://127.0.0.1:54001/fixture.pac';
+  let calls = 0;
+  const rows = windowsDesktopAppAdapter.listProcesses((file, args, options) => {
+    calls++;
+    expect(file).toBe(powershell);
+    expect(options?.timeout).toBe(10_000);
+    expect(options?.windowsHide).toBe(true);
+    const script = args.at(-1)!;
+    expect(script).toContain(Buffer.from(root, 'utf16le').toString('hex'));
+    expect(script).not.toContain(root);
+    expect(script).toContain('GetTokenInformation');
+    expect(script).toContain('GetProcessTimes');
+    expect(script).toContain('CreatedUtcTicks');
+    expect(script).not.toContain('Invoke-CimMethod');
+    expect(script).toContain('$taskP.CommandLine');
+    return '42 10 ' + stamp + ' ' + root + '\\ChatGPT.exe\t' + Buffer.from(commandLine).toString('base64');
+  }, install);
+  expect(calls).toBe(1);
+  expect(rows).toEqual([{ pid: 42, parentPid: 10, createdAt: stamp, executable: root + '\\ChatGPT.exe', commandLine }]);
+});
+
+test('unreadable desktop identity remains unknown; a successful empty snapshot remains empty', () => {
+  setTrustedWindowsElevationExecutablesForTests({ powershell });
+  expect(windowsDesktopAppAdapter.listProcesses(() => { throw Error('unavailable'); }, install)).toBeNull();
+  expect(windowsDesktopAppAdapter.listProcesses(() => '', install)).toEqual([]);
+});
+
+test('desktop parser still rejects a same-prefix neighboring package', () => {
+  setTrustedWindowsElevationExecutablesForTests({ powershell });
+  expect(windowsDesktopAppAdapter.listProcesses(() => '42 10 ' + stamp + ' ' + root + '-foreign\\ChatGPT.exe', install)).toEqual([]);
+});
+
+test('app-server uses the original narrow candidate patterns and public snapshot parser', () => {
+  let calls = 0;
+  const rows = listWindowsSnapshots(script => {
+    calls++;
+    expect(script).toContain('$taskBasenameMatch=');
+    expect(script).toContain('$taskCodeModeMatch=');
+    expect(script).toContain('GetTokenInformation');
+    expect(script).not.toContain('Invoke-CimMethod');
+    expect(script).toContain('Still-live candidate owner identity unavailable');
+    return '42\tC:\\Fixture\\codex.exe app-server\tFIXTURE\\user';
+  });
+  expect(calls).toBe(1);
+  expect(rows).toEqual([{ pid: 42, commandLine: 'C:\\Fixture\\codex.exe app-server', owner: 'FIXTURE\\user' }]);
+});
+
+test('app-server unknown identity refuses partial rows rather than implying no running client', () => {
+  expect(() => parseWindowsSnapshotOutput('42\tC:\\Fixture\\codex.exe app-server\tFIXTURE\\user\n__OCX_ENUM_INCOMPLETE__')).toThrow('windows_enum_incomplete');
+  expect(() => listWindowsSnapshots(() => { throw Error('native probe timeout'); })).toThrow('native probe timeout');
+});
