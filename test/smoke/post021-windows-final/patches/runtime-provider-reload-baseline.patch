+import { afterEach, beforeEach, expect, spyOn, test } from 'bun:test';
+import { ManagementRequest as Request } from '../helpers/management-auth';
+import { readFileSync } from 'node:fs';
+import { loadConfig, saveConfig } from '../../src/config';
+import { saveConfigPreservingClaudeCode } from '../../src/config/live-reconcile';
+import { handleManagementAPI } from '../../src/server/management-api';
+import * as destinations from '../../src/lib/destination-policy';
+import { LOCAL_PROVIDER_RELOAD_NAME_HEADER, LOCAL_PROVIDER_RELOAD_PATH } from '../../src/lib/local-provider-reload-contract';
+import { reconcileSuccessfulModelDiscoveries } from '../../src/providers/new-model-policy';
+import { catalogConvergenceFactory } from '../helpers/catalog-convergence';
+import { createTempHome, type TempHome } from '../helpers/temp-home';
+import type { OcxConfig } from '../../src/types';
+
+const stamp = '2026-01-01T00:00:00.000Z';
+let home: TempHome;
+let dns: ReturnType<typeof spyOn>;
+beforeEach(() => {
+  home = createTempHome('ocx-reload-discovery-');
+  dns = spyOn(destinations, 'providerDestinationResolvedError').mockResolvedValue(null);
+});
+afterEach(() => { dns.mockRestore(); home.remove(); });
+const bytes = () => readFileSync(home.path('config.json'));
+const request = () => new Request('http://127.0.0.1' + LOCAL_PROVIDER_RELOAD_PATH, {
+  method: 'POST', headers: { [LOCAL_PROVIDER_RELOAD_NAME_HEADER]: 'renamed' },
+});
+
+function initial(): OcxConfig {
+  return { port: 0, hostname: '127.0.0.1', defaultProvider: 'original', providers: {
+    original: { adapter: 'openai-chat', baseUrl: 'https://fixture.invalid/v1', models: ['raw-model'], selectedModels: ['raw-model'] },
+    sibling: { adapter: 'openai-chat', baseUrl: 'https://sibling.invalid/v1', models: ['sibling-model'] },
+  }, modelDiscovery: { knownModels: {
+    original: { ids: ['raw-model'], removed: [], updatedAt: stamp },
+    sibling: { ids: ['sibling-model'], removed: [], updatedAt: stamp },
+  } } };
+}
+
+test('reload of a freshly renamed provider uses its persisted discovery baseline before catalog convergence', async () => {
+  saveConfig(initial());
+  const live = loadConfig();
+  const saved = loadConfig();
+  saved.providers.renamed = saved.providers.original!; delete saved.providers.original;
+  saved.defaultProvider = 'renamed';
+  saved.modelDiscovery!.knownModels!.renamed = saved.modelDiscovery!.knownModels!.original!;
+  delete saved.modelDiscovery!.knownModels!.original;
+  saveConfig(saved);
+  const before = bytes();
+  let entered = false;
+  const req = request();
+  const response = await handleManagementAPI(req, new URL(req.url), live, {
+    createManagementConvergeCodex: config => catalogConvergenceFactory(() => {
+      entered = true;
+      const mutable = config as OcxConfig;
+      const changed = reconcileSuccessfulModelDiscoveries({ config: mutable,
+        models: [{ provider: 'renamed', id: 'raw-model' }], authoritativeProviders: ['renamed'], now: '2026-11-05T00:00:00.000Z' });
+      if (changed) saveConfigPreservingClaudeCode(mutable);
+    })(config),
+  }, 'local-provider-reload-capability');
+  expect(response?.status).toBe(200); expect(entered).toBe(true);
+  expect(live.modelDiscovery?.knownModels?.renamed?.updatedAt).toBe(stamp);
+  expect(bytes()).toEqual(before);
+});
+
+test('reload rebases only the target observations and retains unrelated pending live discoveries', async () => {
+  const saved = initial();
+  saved.providers.renamed = saved.providers.original!; delete saved.providers.original;
+  saved.defaultProvider = 'renamed';
+  saved.modelDiscovery!.knownModels!.renamed = saved.modelDiscovery!.knownModels!.original!;
+  delete saved.modelDiscovery!.knownModels!.original;
+  saveConfig(saved);
+  const live = loadConfig();
+  live.modelDiscovery!.knownModels!.renamed!.updatedAt = 'stale-live';
+  live.modelDiscovery!.knownModels!.sibling!.ids.push('pending-sibling');
+  const before = bytes(), req = request();
+  const response = await handleManagementAPI(req, new URL(req.url), live, { createManagementConvergeCodex: catalogConvergenceFactory() }, 'local-provider-reload-capability');
+  expect(response?.status).toBe(200);
+  expect(live.modelDiscovery?.knownModels?.renamed?.updatedAt).toBe(stamp);
+  expect(live.modelDiscovery?.knownModels?.sibling?.ids).toEqual(['sibling-model', 'pending-sibling']);
+  expect(bytes()).toEqual(before);
+});
