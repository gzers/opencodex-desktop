(version 1)
(allow default)
(deny network*)
(deny file-write* (with report))
(allow file-write* (subpath "/private/tmp/ocxd24v-b3ifd2h6"))
(allow file-write* (literal "/dev/null"))
(allow network* (local unix-socket (subpath "/private/tmp/ocxd24v-b3ifd2h6")))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny mach-lookup (global-name "com.apple.securityd"))
(deny file-read* (subpath "/Users/ezio/.codex"))
(deny file-read* (subpath "/Users/ezio/.opencodex"))
(deny file-read* (subpath "/Users/ezio/.codex-desktop"))
(deny file-read* (subpath "/Users/ezio/Library/Application Support/Codex"))
(deny file-read* (subpath "/Users/ezio/Library/Application Support/ChatGPT"))
(deny file-read* (subpath "/Users/ezio/Library/Keychains"))
(deny file-read* (subpath "/Library/Keychains"))
(deny file-read* (subpath "/Users/ezio/Library/Application Support/com.gzers.opencodex.desktop/opencodex-home"))
(deny file-read* (subpath "/Users/ezio/Library/Application Support/com.gzers.opencodex.desktop/manager-state"))
