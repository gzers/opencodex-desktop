    "+        .unwrap();",
    "+        assert!(g",
    "+            .apply_recovery(",
    "+                &p,",
    "+                &event(&g, RecoveryOperation::ReleaseVerified, &r, Some(&n.node_id))",
    "+            )",
    "+            .is_err());",
    "+        assert!(!g.complete_files(&p));",
    "+    }",
    "+    g.apply_lease(&p, &release_event(&g, LeaseReleasedVerified))",
    "+        .unwrap();",
    "+    assert!(",
    "+        g.complete_files(&p),",
    "+        \"necessary DATA only; no actual receipt/Closed factory\"",
