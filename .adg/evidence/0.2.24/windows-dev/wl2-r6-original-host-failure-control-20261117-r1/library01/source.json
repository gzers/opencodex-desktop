                 " if($Mode -eq \u0027r6-fixed-package-paths\u0027){$arguments=@(\u0027test\u0027,\u0027--locked\u0027,\u0027--offline\u0027,\u0027--manifest-path\u0027,\u0027apps/desktop/tauri/Cargo.toml\u0027,\u0027--target\u0027,\u0027x86_64-pc-windows-msvc\u0027,\u0027--features\u0027,\u0027custom-protocol\u0027,\u0027--lib\u0027,\u0027-j\u0027,\u00271\u0027,\u0027--\u0027,\u0027windows_client_originals024::content::\u0027,\u0027windows_diagnostic_roles024::\u0027,\u0027--test-threads=1\u0027,\u0027--nocapture\u0027)}",
