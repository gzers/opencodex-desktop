    "+            steps.push((Phase::Captured, TreeRecord::Completed { root, action }));",
    "+        }",
    "+    }",
    "+    steps.extend(",
    "+        [",
    "+            Phase::Ready,",
    "+            Phase::PreparedRestore,",
    "+            Phase::OfficialTeardown,",
    "+        ]",
    "+        .map(|phase| (phase, TreeRecord::None)),",
