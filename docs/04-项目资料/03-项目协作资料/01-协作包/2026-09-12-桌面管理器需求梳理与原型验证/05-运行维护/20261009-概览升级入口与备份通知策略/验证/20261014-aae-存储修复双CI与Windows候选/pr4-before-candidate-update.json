独立control Node无及时标记仍需Windows后台进程证据，不能用成功轮次认定根因已解。\n\n分支基于确认的Windows透明图标bb3122d，30图标路径和a7三条面板路径原字节保持；main/PR1–3未自动合并。PR4保持草稿，无候选打包、实例切换或FZ50脚本执行。旧bb制品不含新增修复；原macOSCPU/RSS失败、双平台原生/安装数据保留/真实周期/全域事件门禁与原预算保持，不签名、发布、stable晋升或关闭任务。\n","created_at":"2026-10-14T03:47:07Z","updated_at":"2026-10-14T06:23:20Z","closed_at":null,"merged_at":null,"merge_commit_sha":"7365f7b0e776987f2b01e3d034e19990cf924120","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/gzers/opencodex-desktop/pulls/4/commits","review_comments_url":"https://api.github.com/repos/gzers/opencodex-desktop/pulls/4/comments","review_comment_url":"https://api.github.com/repos/gzers/opencodex-desktop/pulls/comments{/number}","comments_url":"https://api.github.com/repos/gzers/opencodex-desktop/issues/4/comments","statuses_url":"https://api.github.com/repos/gzers/opencodex-desktop/statuses/aae2a3fe37a19a33b2f423a1f0b04e5b376c9579","head":{"label":"gzers:feature/0.1.10-integration-candidate","ref":"feature/0.1.10-integration-candidate","sha":"aae2a3fe37a19a33b2f423a1f0b04e5b376c9579","user":{"login":"gzers","id":22311504,"node_id":"MDQ6VXNlcjIyMzExNTA0","avatar_url":"https://avatars.githubusercontent.com/u/22311504?v=4","gravatar_id":"","url":"https://api.github.com/users/gzers","html_url":"https://github.com/gzers","followers_url":"https://api.github.com/users/gzers/followers","following_url":"https://api.github.com/users/gzers/following{/other_user}","gists_url":"https://api.github.com/users/gzers/gists{/gist_id}","starred_url":"https://api.github.com/users/gzers/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gzers/subscriptions","organizations_url":"https://api.github.com/users/gzers/orgs","repos_url":"https://api.github.com/users/gzers/repos","events_url":"https://api.github.com/users/gzers/events{/privacy}","received_events_url":"https://api.github.com/users/gzers/received_events","type":"User",