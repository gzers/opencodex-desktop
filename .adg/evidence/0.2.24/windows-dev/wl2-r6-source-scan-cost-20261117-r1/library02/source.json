    "@@ -121,6 +121,10 @@ if($Mode -eq 'r6-fixed-package-paths'){$arguments=@('test','--locked','--offline",
    " if($Mode -eq 'r6-failure-control'){$arguments=@('test','--locked','--offline','--config','profile.test.package.opencodex-desktop.debug=0','--config','profile.test.package.opencodex-desktop.incremental=false','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--lib','-j','1','--','windows_owner_host024::failure_control::tests::','windows_owner_host024::tests::','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'r6-failure-control-product'){$arguments=@('build','--locked','--offline','--config','profile.dev.package.opencodex-desktop.debug=0','--config','profile.dev.package.opencodex-desktop.incremental=false','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--bins','-j','1')}",
    " if($Mode -eq 'r6-fresh-fixture'){$arguments=@('test','--locked','--offline','--config','profile.test.package.opencodex-desktop.debug=0','--config','profile.test.package.opencodex-desktop.incremental=false','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','--','windows_client_originals024::existing_qualification::tests::','windows_client_originals024::existing_qualification::fresh_fixture::tests::','windows_owner_host024::failure_control::tests::','windows_owner_host024::tests::','--test-threads=1','--nocapture')}",
    "+if($Mode -eq 'r6-source-scan-cost'){",
    "+ $env:OCXD024_SOURCE_SCAN_COST_ROOT=\"$PSScriptRoot/target/r6-source-scan-cost-$([guid]::NewGuid().ToString('N'))\"",
    "+ $arguments=@('test','--locked','--offline','--config','profile.test.package.opencodex-desktop.debug=0','--config','profile.test.package.opencodex-desktop.incremental=false','--config','profile.test.package.opencodex-desktop.codegen-units=256','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','wl2_r6_source_scan_cost_fixed_full_image_no_owner','--','--ignored','--test-threads=1','--nocapture')",
