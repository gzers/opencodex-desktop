    "+            Artifact::Catalog,",
    "+            Artifact::ModelsCache,",
    "+            Artifact::CatalogAudit,",
    "+        ]) {",
    "+            if *artifact != expected",
    "+                || !matches!(action, Action::AlreadyOriginal | Action::RestoreOriginal)",
    "+            {",
    "+                return Err(invalid());",
    "+            }",
    "+        }",
    "+        Ok(())",
    "+    }",
