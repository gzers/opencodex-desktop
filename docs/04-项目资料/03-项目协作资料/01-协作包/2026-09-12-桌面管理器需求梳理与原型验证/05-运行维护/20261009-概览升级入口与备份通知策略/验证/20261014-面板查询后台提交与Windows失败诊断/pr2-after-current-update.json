保持草稿；main、PR #1 和图标 PR #3 未自动合并。新诊断只记录原 Windows 夹具阶段，继续定位原因，两秒截止与清理断言不变。\n","created_at":"2026-10-14T00:38:48Z","updated_at":"2026-10-14T03:41:37Z","closed_at":null,"merged_at":null,"merge_commit_sha":"1028ff879896c9dc4a04d40a4564b9d5c616742f","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/gzers/opencodex-desktop/pulls/2/commits","review_comments_url":"https://api.github.com/repos/gzers/opencodex-desktop/pulls/2/comments","review_comment_url":"https://api.github.com/repos/gzers/opencodex-desktop/pulls/comments{/number}","comments_url":"https://api.github.com/repos/gzers/opencodex-desktop/issues/2/comments","statuses_url":"https://api.github.com/repos/gzers/opencodex-desktop/statuses/fd31d7167c03b1e4e83554a9bf778a2ffb9baf4e","head":{"label":"gzers:feature/0.1.10-release-details","ref":"feature/0.1.10-release-details","sha":"fd31d7167c03b1e4e83554a9bf778a2ffb9baf4e","user":{"login":"gzers","id":22311504,"node_id":"MDQ6VXNlcjIyMzExNTA0","avatar_url":"https://avatars.githubusercontent.com/u/22311504?v=4","gravatar_id":"","url":"https://api.github.com/users/gzers","html_url":"https://github.com/gzers","followers_url":"https://api.github.com/users/gzers/followers","following_url":"https://api.github.com/users/gzers/following{/other_user}","gists_url":"https://api.github.com/users/gzers/gists{/gist_id}","starred_url":"https://api.github.com/users/gzers/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gzers/subscriptions","organizations_url":"https://api.github.com/users/gzers/orgs","repos_url":"https://api.github.com/users/gzers/repos","events_url":"https://api.github.com/users/gzers/events{/privacy}","received_events_url":"https://api.github.com/users/gzers/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1369202675,"node_id":"R_kgDOUZxf8w","name":"opencodex-desktop","full_name":"gzers/opencodex-desktop","pri