{
  "name": "opencodex-desktop-ui",
  "private": true,
  "version": "0.2.10",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "audit:browser": "node qa/audit.browser.mjs",
    "inventory:components": "node qa/component-inventory.mjs",
    "audit:models": "node qa/model-visual.mjs",
    "audit:preview": "node qa/preview-visual.mjs",
    "audit:catalog-naming": "node qa/catalog-naming-real.mjs",
    "audit:catalog-crossvalidate": "node qa/catalog-naming-crossvalidate.mjs",
    "audit:export": "node qa/export-visual.mjs",
    "audit:template": "node qa/template-visual.mjs",
    "audit:update": "node qa/update-visual.mjs",
    "audit:geometry": "node qa/geometry-visual.mjs",
    "audit:geometry:webkit": "node qa/geometry-webkit.mjs",
    "audit:webkit": "AUDIT_ENGINE=webkit node qa/model-visual.mjs && AUDIT_ENGINE=webkit node qa/preview-visual.mjs && AUDIT_ENGINE=webkit node qa/geometry-visual.mjs && AUDIT_ENGINE=webkit node qa/template-visual.mjs && AUDIT_ENGINE=webkit node qa/export-visual.mjs && AUDIT_ENGINE=webkit node qa/update-visual.mjs",
    "gate:release": "node qa/gate-release.mjs",
    "audit:parity": "node qa/parity-preview.mjs",
    "audit:parity:template": "node qa/parity-template.mjs",
    "audit:parity:export": "node qa/parity-export.mjs",
    "audit:parity:list": "node qa/parity-list.mjs",
    "audit:parity:agent": "node qa/parity-agent.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "jsdom": "27.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
