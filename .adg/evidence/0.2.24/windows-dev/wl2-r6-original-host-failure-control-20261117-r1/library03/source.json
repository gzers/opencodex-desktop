    " if($Mode -eq 'r6-profile-preflight'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','desktop_preflight_tests::','--','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'r6-existing-qualification'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','--','windows_client_originals024::existing_qualification::tests::','windows_official_lifecycle024::actions::','wl2_restart_','windows_sample_tests::','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'r6-fixed-package-paths'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','--','windows_client_originals024::content::','windows_diagnostic_roles024::','--test-threads=1','--nocapture')}",
    "+if($Mode -eq 'r6-failure-control'){$arguments=@('test','--locked','--offline','--config','profile.test.package.opencodex-desktop.debug=0','--config','profile.test.package.opencodex-desktop.incremental=false','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--lib','-j','1','--','windows_owner_host024::failure_control::tests::','windows_owner_host024::tests::','--test-threads=1','--nocapture')}",
    "+if($Mode -eq 'r6-failure-control-product'){$arguments=@('build','--locked','--offline','--config','profile.dev.package.opencodex-desktop.debug=0','--config','profile.dev.package.opencodex-desktop.incremental=false','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--bins','-j','1')}",
    " if($Mode -eq 'r6-batch-native'){$arguments=@('test','--release','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','--','windows_client_originals024::v3::','wl2_r6_batch_native_','wl2_r6_completed_history_','wl2_r6_capture_','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'r6-completed-native'){$arguments=@('test','--release','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','wl2_r6_completed_history_','--','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'r6-completed-regression'){$arguments=@('test','--release','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','--','windows_client_originals024::v3::','wl2_r6_recovery_chain_native_','wl2_r6_handles_handoff_native_','wl2_r6_completed_history_','--test-threads=1','--nocapture')}"
