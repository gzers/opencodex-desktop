    "+            original_end.saturating_duration_since(Instant::now())",
    "+                + std::time::Duration::from_millis(1),",
    "+        );",
    "+        let fresh_read_end = Instant::now() + std::time::Duration::from_secs(1);",
    "+        receipt.readback_history(fresh_read_end).unwrap();",
