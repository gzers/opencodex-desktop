    "diff --git a/apps/desktop/tauri/src/infrastructure/windows_official_lifecycle024_tests.rs b/apps/desktop/tauri/src/infrastructure/windows_official_lifecycle024_tests.rs",
    "index 642675b80..9143137c0 100644",
    "--- a/apps/desktop/tauri/src/infrastructure/windows_official_lifecycle024_tests.rs",
