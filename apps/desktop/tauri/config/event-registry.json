  "notification_policies": [
    {
      "id": "start_failure",
      "level": "danger",
      "category": "run",
      "source": "runtime",
      "title": "OpenCodex 启动失败",
      "body": "官方命令未成功完成；具体原因以诊断中心日志中的同动作记录为准。",
