  "diff": [
    "diff --git a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/tree.rs b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/tree.rs",
    "index 20a84fc20..fb3ac94fe 100644",
    "--- a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/tree.rs",
    "+++ b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/tree.rs",
    "@@ -547,6 +547,44 @@ pub(super) mod tests {",
    "         Instant::now() + std::time::Duration::from_secs(10)",
    "     }",
    "     #[test]",
    "+    fn wl2_r4_retired_working_external_edit_vetoes_restored_readback() {",
    "+        let mut temp = Fixture::new();",
    "+        let profile = create_private_directory(&temp.path().join(\"Profile\")).unwrap();",
    "+        let codex = profile.path().join(\".codex\");",
    "+        std::fs::create_dir(&codex).unwrap();",
    "+        std::fs::write(codex.join(\"config.toml\"), b\"synthetic original config\").unwrap();",
    "+        let custody = create_private_directory(&profile.path().join(\"task-custody\")).unwrap();",
    "+        let journal = create_private_directory(&temp.path().join(\"D\")).unwrap();",
    "+        let mut original = RootTree::capture(&codex, end()).unwrap();",
    "+        let original_nodes = original.manifest_nodes(end()).unwrap();",
    "+        original",
    "+            .move_to_custody(custody.path(), &journal.path().join(\"intent.json\"), end())",
    "+            .unwrap();",
    "+        original.create_working_copy(end()).unwrap();",
    "+        original.restore_original(end()).unwrap();",
    "+        original.verify_restored(end()).unwrap();",
    "+        assert_eq!(original.manifest_nodes(end()).unwrap(), original_nodes);",
    "+        let foreign = custody.path().join(\"retired-working-.codex/foreign.new\");",
    "+        std::fs::write(&foreign, b\"synthetic unknown retirement drift\").unwrap();",
    "+        assert!(",
    "+            original.verify_restored(end()).is_err(),",
    "+            \"retired working generation cannot disappear from final native readback\"",
    "+        );",
    "+        assert!(original.poisoned);",
    "+        assert!(original.verify_restored(end()).is_err());",
    "+        assert_eq!(",
    "+            std::fs::read(codex.join(\"config.toml\")).unwrap(),",
    "+            b\"synthetic original config\"",
    "+        );",
    "+        assert!(foreign.exists());",
    "+        drop(original);",
    "+        drop(journal);",
    "+        drop(custody);",
    "+        drop(profile);",
    "+        println!(\"retired working unknown node refuses restored readback and poisons retained tree; exact original restored, foreign scene retained, no Closed/native lifecycle eligibility\");",
    "+        temp.retain();",
    "+    }",
    "+    #[test]",
    "     fn wl2_r4_native_whole_tree_custody_workcopy_restore_same_ids_and8projections() {",
    "         let temp = Fixture::new();",
    "         let profile = temp.path().join(\"Profile\");",
    "diff --git a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs",
    "index 5bbaa51be..83166d061 100644",
    "--- a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs",
    "+++ b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs",
    "@@ -365,6 +365,33 @@ mod tests {",
    "         .unwrap()",
    "     }",
    "     #[test]",
    "+    fn wl2_r4_retired_working_drift_keeps_canonical_aborted_reference() {",
    "+        let mut temp = Fixture::new();",
    "+        let mut captured = TreeCaptureV2::capture(setup(&temp), end()).unwrap();",
    "+        let directory = captured.pending.directory.path().to_path_buf();",
    "+        captured.create_working_trees(end()).unwrap();",
    "+        captured.restore_exact(end()).unwrap();",
    "+        let foreign = captured",
    "+            .custody",
    "+            .path()",
    "+            .join(\"retired-working-.codex/foreign.new\");",
    "+        std::fs::write(&foreign, b\"synthetic retired-tree external drift\").unwrap();",
    "+        assert!(",
    "+            captured.recheck(end()).is_err(),",
    "+            \"canonical readback must not forget the retired working tree\"",
    "+        );",
    "+        assert_eq!(captured.pending.tip.sequence, 14);",
    "+        assert!(captured.pending.tip.phase == Phase::Aborted);",
    "+        assert!(foreign.exists());",
    "+        drop(captured);",
    "+        let pending = read_pending(&directory).unwrap();",
    "+        assert!(pending.current_matches && !pending.terminal_record_only);",
    "+        assert_eq!(pending.tip.sequence, 14);",
    "+        drop(pending);",
    "+        println!(\"retired working drift refuses native canonical recheck; original restored but exact Aborted/current prefix unchanged, conflict retained, no successor or Closed proof\");",
    "+        temp.retain();",
    "+    }",
    "+    #[test]",
    "     fn wl2_r4_unperformed_native_root_moves_refuse_ready_before_phase_write() {",
    "         let temp = Fixture::new();",
    "         let mut captured = TreeCaptureV2::capture(setup(&temp), end()).unwrap();",
    "diff --git a/test/windows024-native/build-wl2.ps1 b/test/windows024-native/build-wl2.ps1",
