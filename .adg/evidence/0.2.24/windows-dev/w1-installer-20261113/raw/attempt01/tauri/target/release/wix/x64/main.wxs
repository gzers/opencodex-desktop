<!-- OCX023-UPSTREAM-BEGIN -->
<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
            Id="*"
            Name="OpenCodeX Desktop"
            UpgradeCode="77eaf3e9-84df-48e4-b493-a267ab705070"
            Language="!(loc.TauriLanguage)"
            Manufacturer="gzers"
            Version="0.2.24">

        <Package Id="*"
                 Keywords="Installer"
                 InstallerVersion="450"
                 Languages="0"
                 Compressed="yes"
                 InstallScope="perUser"
                 InstallPrivileges="limited"
                 SummaryCodepage="!(loc.TauriCodepage)"/>

        <!-- https://docs.microsoft.com/en-us/windows/win32/msi/reinstallmode -->
        <!-- reinstall all files; rewrite all registry entries; reinstall all shortcuts -->
        <Property Id="REINSTALLMODE" Value="amus" />

        <!-- Auto launch app after installation, useful for passive mode which usually used in updates -->
        <Property Id="AUTOLAUNCHAPP" Secure="yes" />
        <!-- Property to forward cli args to the launched app to not lose those of the pre-update instance -->
        <Property Id="LAUNCHAPPARGS" Secure="yes" />

            <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />

        <InstallExecuteSequence>
            <RemoveShortcuts>Installed AND NOT UPGRADINGPRODUCTCODE</RemoveShortcuts>
        </InstallExecuteSequence>

        <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />


        <Icon Id="ProductIcon" SourceFile="C:\Users\15119\.codex\worktrees\024-windows-native\code\test\windows024-native\target\installer-w1\attempt01\tauri\target\release\resources\icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />      <!-- Remove repair -->
        <SetProperty Id="ARPNOMODIFY" Value="1" After="InstallValidate" Sequence="execute"/>


        <!-- Only the new per-user installation remembers a custom I. Old
             NSIS/MSI roots must not redirect the new Programs default. -->
        <Property Id="OCX023_REMEMBERED_I">
          <RegistrySearch Id="OCX023PreviousInstallDir" Root="HKCU" Key="Software\gzers\OpenCodeX Desktop\023" Name="InstallDir" Type="raw" />
        </Property>
        <Property Id="INSTALLDIR" Secure="yes" />
        <SetProperty Id="INSTALLDIR" Value="[OCX023_REMEMBERED_I]" Before="CostInitialize" Sequence="both">NOT INSTALLDIR AND OCX023_REMEMBERED_I</SetProperty>

        <!-- Read-only identity of the digest-pinned published 022 MSI:
             asset 715405068, ProductCode from its Property table, ALLUSERS=1.
             MSI major upgrades cannot cross machine/user installation context.
             Never auto-remove the old machine app or silently claim upgrade.
             提示：先卸载旧管理器（保留配置），再安装新版。
             The en-US MSI uses an ASCII message compatible with codepage 1252. -->
        <Property Id="OCX023_MACHINE022">
          <RegistrySearch Id="OCX023Machine022x64" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{C5476FDD-CB86-46AF-A97F-96DD56A32CA0}" Name="DisplayVersion" Type="raw" Win64="yes" />
          <RegistrySearch Id="OCX023Machine022x86" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{C5476FDD-CB86-46AF-A97F-96DD56A32CA0}" Name="DisplayVersion" Type="raw" Win64="no" />
        </Property>
        <Condition Message="OCX023_MACHINE022_BLOCK: Uninstall the old manager first (retain configuration), then install the new version. OpenCodeX Desktop 0.2.22 is per-machine; 0.2.24 is per-user. No data is migrated.">Installed OR NOT OCX023_MACHINE022</Condition>
        <Condition Message="OpenCodeX Desktop 0.2.24 requires a current-user installation.">NOT ALLUSERS</Condition>

        <!-- launch app checkbox -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
        <CustomAction Id="LaunchApplication" Impersonate="yes" FileKey="Path" ExeCommand="[LAUNCHAPPARGS]" Return="asyncNoWait" />

        <UI>
            <!-- launch app checkbox -->
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

            <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

            <!-- Skip license dialog -->
            <Publish Dialog="WelcomeDlg"
                     Control="Next"
                     Event="NewDialog"
                     Value="InstallDirDlg"
                     Order="2">1</Publish>
            <Publish Dialog="InstallDirDlg"
                     Control="Back"
                     Event="NewDialog"
                     Value="WelcomeDlg"
                     Order="2">1</Publish>
        </UI>

        <UIRef Id="WixUI_InstallDir" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="ApplicationShortcutDesktop" Guid="*">
                    <Shortcut Id="ApplicationDesktopShortcut" Name="OpenCodeX Desktop" Description="Runs OpenCodeX Desktop" Target="[!Path]" WorkingDirectory="INSTALLDIR" />
                    <RemoveFolder Id="DesktopFolder" On="uninstall" />
                    <RegistryValue Root="HKCU" Key="Software\gzers\OpenCodeX Desktop" Name="Desktop Shortcut" Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </Directory>
            <Directory Id="LocalAppDataFolder">
                <Directory Id="OCX023ProgramsFolder" Name="Programs">
                    <Directory Id="INSTALLDIR" Name="OpenCodeX Desktop"/>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="OpenCodeX Desktop"/>
            </Directory>
        </Directory>

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="RegistryEntries" Guid="*">
                <RegistryKey Root="HKCU" Key="Software\gzers\OpenCodeX Desktop\023">
                    <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                </RegistryKey>
                <!-- Per-user protocol registration uses the installing user. -->
</Component>
            <Component Id="Path" Guid="97e90686-c235-539e-9059-0f628f361b6a" Win64="$(var.Win64)">
                <File Id="Path" Source="C:\Users\15119\.codex\worktrees\024-windows-native\code\test\windows024-native\target\installer-w1\attempt01\tauri\target\release\ocxd.exe" Checksum="yes"/>
                <RegistryValue Root="HKCU" Key="Software\gzers\OpenCodeX Desktop\023\Components" Name="Desktop" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
</Component>
            <!-- Stable OCX023 component IDs/GUIDs/registration keys describe
                 installation identity, not the selected runtime version.
                 Shared024 stage supplies the real Windows descriptor and pin;
                 no Mac descriptor or hardcoded archive digest is used here. -->
            <!-- OCX023-PAYLOAD-BEGIN
                 bundler 2.9.4 emits opaque resource XML with directory key paths.
                 ICE38 requires HKCU registry key paths under a user profile.
                 Enumerate the complete, fixed official024 staging contract instead of
                 suppressing MSI validation. SourceDir is the native Windows
                 target/release executable supplied by Tauri's candle command;
                 SourceDir/../../.. resolves to the tauri project. Cross-target
                 output layouts require an explicit reviewed template change.
                 A missing staged offline payload is a compile error, not a
                 network/old-program fallback. No business U/H files here. -->
            <Directory Id="OCX023Documents" Name="resources">
                <!-- WiX CNDL0230: multiple files with an HKCU key path need
                     an explicit stable component GUID. This x64 component
                     identity remains fixed across builds and reinstalls. -->
                <Component Id="OCX023Documents" Guid="9501D6A2-BA37-53EA-B53A-10CB8E34412E" Win64="$(var.Win64)">
                    <File Id="OCX023License" Source="$(var.SourceDir)\..\..\..\resources\LICENSE" />
                    <File Id="OCX023Notices" Source="$(var.SourceDir)\..\..\..\resources\THIRD-PARTY-NOTICES.txt" />
                    <RegistryValue Root="HKCU" Key="Software\gzers\OpenCodeX Desktop\023\Components" Name="Documents" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                    <RemoveFolder Id="OCX023RemoveDocuments" Directory="OCX023Documents" On="uninstall" />
                </Component>
            </Directory>
            <Directory Id="OCX023RuntimeBundle" Name="runtime-bundle">
                <Component Id="OCX023RuntimeBundle" Guid="7F3ED10E-ADBA-56E4-B6A1-EFC692135F8C" Win64="$(var.Win64)">
                    <File Id="OCX023RuntimeArchive" Source="$(var.SourceDir)\..\..\..\resources\runtime-bundle\runtime-bundle-0.2.24-win32-x64.tar.gz" />
                    <File Id="OCX023RuntimeSource" Source="$(var.SourceDir)\..\..\..\resources\runtime-bundle\official-runtime.tgz" />
                    <File Id="OCX023RuntimeManifest" Source="$(var.SourceDir)\..\..\..\resources\runtime-bundle\runtime-bundle.manifest.json" />
                    <File Id="OCX023RuntimePin" Source="$(var.SourceDir)\..\..\..\resources\runtime-bundle\runtime-bundle.manifest.sha256" />
                    <RegistryValue Root="HKCU" Key="Software\gzers\OpenCodeX Desktop\023\Components" Name="RuntimeBundle" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                    <RemoveFolder Id="OCX023RemoveRuntimeBundle" Directory="OCX023RuntimeBundle" On="uninstall" />
                </Component>
            </Directory>
            <!-- OCX023-PAYLOAD-END -->
            <Component Id="CMP_UninstallShortcut" Guid="*">

                <Shortcut Id="UninstallShortcut"
						  Name="Uninstall OpenCodeX Desktop"
						  Description="Uninstalls OpenCodeX Desktop"
						  Target="[System64Folder]msiexec.exe"
						  Arguments="/x [ProductCode]" />

				<RemoveFolder Id="INSTALLDIR"
							  On="uninstall" />
                <RemoveFolder Id="OCX023RemovePrograms" Directory="OCX023ProgramsFolder" On="uninstall" />

				<RegistryValue Root="HKCU"
							   Key="Software\gzers\OpenCodeX Desktop"
							   Name="Uninstaller Shortcut"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="*">
                <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="OpenCodeX Desktop"
                    Description="Runs OpenCodeX Desktop"
                    Target="[!Path]"
                    Icon="ProductIcon"
                    WorkingDirectory="INSTALLDIR">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="com.gzers.opencodex.w1-resource-proof"/>
                </Shortcut>
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\gzers\OpenCodeX Desktop" Name="Start Menu Shortcut" Type="integer" Value="1" KeyPath="yes"/>
           </Component>
        </DirectoryRef>

<Feature
                Id="MainProgram"
                Title="Application"
                Description="!(loc.InstallAppFeature)"
                Level="1"
                ConfigurableDirectory="INSTALLDIR"
                AllowAdvertise="no"
                Display="expand"
                Absent="disallow">

            <ComponentRef Id="RegistryEntries"/>

            <!-- OCX023-RESOURCE-REFS-BEGIN -->
            <ComponentRef Id="OCX023Documents" />
            <ComponentRef Id="OCX023RuntimeBundle" />
            <!-- OCX023-RESOURCE-REFS-END -->


            <Feature Id="ShortcutsFeature"
                Title="Shortcuts"
                Level="1">
                <ComponentRef Id="Path"/>
                <ComponentRef Id="CMP_UninstallShortcut" />
                <ComponentRef Id="ApplicationShortcut" />
                <ComponentRef Id="ApplicationShortcutDesktop" />
            </Feature>

            <Feature
                Id="Environment"
                Title="PATH Environment Variable"
                Description="!(loc.PathEnvVarFeature)"
                Level="1"
                Absent="allow">
            <ComponentRef Id="Path"/>
</Feature>
        </Feature>

        <Feature Id="External" AllowAdvertise="no" Absent="disallow">
</Feature>



        <InstallExecuteSequence>
          <Custom Action="LaunchApplication" After="InstallFinalize">AUTOLAUNCHAPP AND NOT Installed</Custom>
        </InstallExecuteSequence>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>
    </Product>
</Wix>
