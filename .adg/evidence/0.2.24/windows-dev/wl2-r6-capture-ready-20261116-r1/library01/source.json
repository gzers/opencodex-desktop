    "+    core.release_prepared(&mut lease, end).unwrap();",
    "+    std::fs::write(root.join(\"config.toml\"), b\"unexpected pre-creator mutation\").unwrap();",
    "+    assert!(super::super::segments::reacquire_trees(",
    "+        &mut core.trees,",
    "+        &mut core.journal,",
    "+        &mut lease,",
    "+        None,",
    "+        end",
    "+    )",
