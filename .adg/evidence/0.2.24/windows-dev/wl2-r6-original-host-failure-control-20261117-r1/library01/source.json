                 "@@ -1015,6 +1015,49 @@ pub(crate) fn qualify_existing(",
                 "     ))",
                 " }",
                 " #[cfg(debug_assertions)]",
                 "+pub(crate) struct QualificationFailureCleanup {",
                 "+    pub(crate) report: serde_json::Value,",
                 "+}",
                 "+/// Only called by the original debug host after native peer authentication",
                 "+/// and a locally retained failed Result. Neither a PID nor a JSON receipt can",
                 "+/// reconstruct this registry entry or its original Job. Custody is never moved.",
                 "+#[cfg(debug_assertions)]",
                 "+pub(crate) fn qualification_failure_cleanup(",
                 "+    runtime: \u0026SharedRuntimeExecutable,",
                 "+    home: \u0026Path,",
                 "+    deadline: Instant,",
                 "+) -\u003e std::io::Result\u003cQualificationFailureCleanup\u003e {",
                 "+    budget(deadline).map_err(std::io::Error::other)?;",
                 "+    let entry = slot(runtime, home, false).map_err(std::io::Error::other)?;",
                 "+    let mut guard = entry",
                 "+        .owner",
                 "+        .try_lock()",
                 "+        .map_err(|_| std::io::Error::other(\"original Owner busy\"))?;",
                 "+    let owner = guard",
                 "+        .as_mut()",
                 "+        .ok_or_else(|| std::io::Error::other(\"original Owner missing\"))?;",
                 "+    entry.cancel.store(true, Ordering::SeqCst);",
                 "+    budget(deadline).map_err(std::io::Error::other)?;",
                 "+    let forced = owner.native.force_owned_cleanup(deadline)?;",
                 "+    // Forced cleanup never closes an original phase, restores clients, or",
                 "+    // proves previous owners absent. Keep those originals and their host alive.",
                 "+    owner.stopped = false;",
                 "+    owner.stop_completion = None;",
                 "+    owner.stage = \"forced-failure-cleanup\";",
                 "+    Ok(QualificationFailureCleanup {",
                 "+        report: serde_json::json!({",
                 "+            \"forced\":forced.forced, \"root\":format!(\"{:?}\",forced.final_state.root),",
                 "+            \"active\":forced.final_state.active_processes,",
                 "+            \"total\":forced.final_state.total_processes,",
                 "+            \"originalPhaseRetained\":owner.original_phase.is_some(),",
                 "+            \"previousOwners\":owner.previous.len(), \"hostMayExit\":false,",
                 "+            \"forcedExitCode\":242,",
                 "+            \"normalStop\":false, \"closed\":false, \"clientsRestored\":false,",
                 "+            \"allAccepted\":false, \"publicStartOpen\":false",
                 "+        }),",
                 "+    })",
                 "+}",
                 "+#[cfg(debug_assertions)]",
                 " pub(crate) fn qualification_trace(",
                 "     runtime: \u0026SharedRuntimeExecutable,",
                 "     home: \u0026Path,",
                 "diff --git a/apps/desktop/tauri/src/infrastructure/windows_owner_host024/empty_host.rs b/apps/desktop/tauri/src/infrastructure/windows_owner_host024/empty_host.rs",
                 "index 852af7513..382c2320f 100644",
                 "--- a/apps/desktop/tauri/src/infrastructure/windows_owner_host024/empty_host.rs",
                 "+++ b/apps/desktop/tauri/src/infrastructure/windows_owner_host024/empty_host.rs",
                 "@@ -434,6 +434,10 @@ pub fn run_from_inherited_bootstrap() -\u003e io::Result\u003c()\u003e {",
                 "     }",
                 "     run_empty(config)",
                 " }",
                 "+#[cfg(debug_assertions)]",
                 "+pub fn request_existing_failure_cleanup() -\u003e io::Result\u003cserde_json::Value\u003e {",
                 "+    super::failure_control::request_cleanup()",
                 "+}",
                 " #[cfg(test)]",
                 " mod tests {",
                 "     use super::*;",
                 "diff --git a/apps/desktop/tauri/src/infrastructure/windows_owner_host024/existing_qualification.rs b/apps/desktop/tauri/src/infrastructure/windows_owner_host024/existing_qualification.rs",
                 "index d27c1bc10..589e2db89 100644",
                 "--- a/apps/desktop/tauri/src/infrastructure/windows_owner_host024/existing_qualification.rs",
                 "+++ b/apps/desktop/tauri/src/infrastructure/windows_owner_host024/existing_qualification.rs",
                 "@@ -93,6 +93,9 @@ pub(super) fn run(c: EmptyBootstrap) -\u003e io::Result\u003c()\u003e {",
                 "         \"original-broker-admitted\",",
                 "         json!({\"pid\":current.identity().pid,\"filetime\":current.identity().creation_filetime.to_string(),\"sid\":token.sid,\"session\":token.session_id,\"elevated\":false,\"noOuterJob\":true,\"officialOwnerCreated\":false,\"profile\":profile,\"I\":c.installation,\"D\":c.data,\"H\":c.home}),",
                 "     )?;",
                 "+    // Establish reachability before any fallible native Owner creation. The",
                 "+    // locator is DATA only; every request authenticates the native pipe peer.",
                 "+    let control = super::failure_control::Control::create(\u0026c, current)?;",
                 "     let mut runtime_for_trace: Option\u003cSharedRuntimeExecutable\u003e = None;",
                 "     let result = (|| -\u003e io::Result\u003cValue\u003e {",
                 "         let q = ExistingQualification::prepare()?;",
                 "@@ -168,18 +171,20 @@ pub(super) fn run(c: EmptyBootstrap) -\u003e io::Result\u003c()\u003e {",
                 "         .unwrap_or_else(",
                 "             || json!({\"nativeOwner\":false,\"creatorResumed\":false,\"preparationOnly\":true}),",
                 "         );",
                 "+    let failed = result.is_err();",
                 "     let final_result = match result {",
                 "         Ok(v) =\u003e v,",
                 "         Err(e) =\u003e {",
                 "             json!({\"nativeProductionSequencePassed\":false,\"raw\":e.raw_os_error(),\"firstError\":e.to_string(),\"actualProductionExecuted\":trace[\"creatorResumed\"]==true,\"nativeOwnerRetained\":trace[\"nativeOwner\"]==true,\"trace\":trace,\"allAccepted\":false,\"startOpen\":false})",
                 "         }",
                 "     };",
                 "-    event(\u0026mut log, \"qualification-result\", final_result.clone())?;",
                 "-    write_new(\u0026c.data.join(\"qualification-result.json\"), \u0026final_result)?;",
                 "+    // A failed evidence write must not strand an original Owner by dropping",
                 "+    // the host. The control loop records these errors and remains reachable.",
                 "+    let evidence_error = event(\u0026mut log, \"qualification-result\", final_result.clone())",
                 "+        .and_then(|_| write_new(\u0026c.data.join(\"qualification-result.json\"), \u0026final_result))",
                 "+        .err();",
                 "     // Success retains original closed history; failure retains ALL original",
                 "     // Owner/Job/custody and exact prefixes. No implicit exit/Drop, termination,",
                 "     // retry/rollforward or public admission follows this diagnostic result.",
                 "-    loop {",
                 "-        std::thread::park_timeout(Duration::from_secs(30));",
                 "-    }",
                 "+    control.serve(\u0026mut log, runtime_for_trace.as_ref(), failed, evidence_error)",
                 " }",
