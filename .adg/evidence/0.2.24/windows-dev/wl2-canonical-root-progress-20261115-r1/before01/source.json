  "diff": [
    "diff --git a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs",
    "index 8161044b9..5bbaa51be 100644",
    "--- a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs",
    "+++ b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/capture.rs",
    "@@ -365,6 +365,31 @@ mod tests {",
    "         .unwrap()",
    "     }",
    "     #[test]",
    "+    fn wl2_r4_unperformed_native_root_moves_refuse_ready_before_phase_write() {",
    "+        let temp = Fixture::new();",
    "+        let mut captured = TreeCaptureV2::capture(setup(&temp), end()).unwrap();",
    "+        let directory = captured.pending.directory.path().to_path_buf();",
    "+        let current_before = std::fs::read(directory.join(\"phase-00000001.json\")).unwrap();",
    "+        let original = captured.pins[0].path().join(\".codex/config.toml\");",
    "+        assert!(",
    "+            captured.advance_phase(Phase::Ready, end()).is_err(),",
    "+            \"native append must not publish Ready without recorded working roots\"",
    "+        );",
    "+        assert!(captured.failed);",
    "+        assert!(original.exists());",
    "+        assert!(!captured.custody.path().join(\".codex\").exists());",
    "+        assert!(!directory.join(\"phase-00000002.json\").exists());",
    "+        assert_eq!(",
    "+            std::fs::read(directory.join(\"phase-00000001.json\")).unwrap(),",
    "+            current_before",
    "+        );",
    "+        drop(captured);",
    "+        let pending = read_pending(&directory).unwrap();",
    "+        assert_eq!(pending.tip.sequence, 1);",
    "+        assert!(pending.current_matches && !pending.terminal_record_only);",
    "+        println!(\"native premature Ready refused before extra phase/current mutation, original root unchanged, canonical Captured/current remains pending; no retry or production proof\");",
    "+    }",
    "+    #[test]",
    "     fn wl2_r4_native_manifest_and_exclusive_v2_intent_precede_both_root_moves() {",
    "         let temp = Fixture::new();",
    "         let mut captured = TreeCaptureV2::capture(setup(&temp), end()).unwrap();",
    "diff --git a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/tests.rs b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/tests.rs",
    "index 39f8c656c..74a8a94dc 100644",
    "--- a/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/tests.rs",
    "+++ b/apps/desktop/tauri/src/infrastructure/windows_client_originals024/v2/tests.rs",
    "@@ -14,6 +14,55 @@ fn progress_prefix(steps: &[(Phase, TreeRecord)]) -> (Vec<u8>, Vec<Vec<u8>>) {",
    "     (manifest, records)",
    " }",
    " #[test]",
    "+fn wl2_r4_unperformed_roots_cannot_cross_ready_or_closed_in_v2_records() {",
    "+    let sid = current_identity().unwrap().sid;",
    "+    let (manifest, records) = progress_prefix(&[(Phase::Ready, TreeRecord::None)]);",
    "+    assert!(",
    "+        check_prefix(&manifest, &records, &sid).is_err(),",
    "+        \"pure Ready text without either actual recorded root step must refuse\"",
    "+    );",
    "+    let mut steps = Vec::new();",
    "+    for root in [TreeRoot::Codex, TreeRoot::Grok] {",
    "+        for action in [TreeAction::MoveToCustody, TreeAction::CreateWorkingCopy] {",
    "+            steps.push((Phase::Captured, TreeRecord::Intent { root, action }));",
    "+            steps.push((Phase::Captured, TreeRecord::Completed { root, action }));",
    "+        }",
    "+    }",
    "+    steps.extend(",
    "+        [",
    "+            Phase::Ready,",
    "+            Phase::PreparedRestore,",
    "+            Phase::OfficialTeardown,",
    "+        ]",
    "+        .map(|phase| (phase, TreeRecord::None)),",
    "+    );",
    "+    let mut premature = steps.clone();",
    "+    premature.push((Phase::Restored, TreeRecord::None));",
    "+    let (manifest, records) = progress_prefix(&premature);",
    "+    assert!(check_prefix(&manifest, &records, &sid).is_err());",
    "+    for root in [TreeRoot::Codex, TreeRoot::Grok] {",
    "+        let action = TreeAction::RestoreOriginal;",
    "+        steps.push((Phase::OfficialTeardown, TreeRecord::Intent { root, action }));",
    "+        steps.push((",
    "+            Phase::OfficialTeardown,",
    "+            TreeRecord::Completed { root, action },",
    "+        ));",
    "+        if root == TreeRoot::Codex {",
    "+            let mut partial = steps.clone();",
    "+            partial.push((Phase::Restored, TreeRecord::None));",
    "+            let (manifest, records) = progress_prefix(&partial);",
    "+            assert!(check_prefix(&manifest, &records, &sid).is_err());",
    "+        }",
    "+    }",
    "+    steps.extend([Phase::Restored, Phase::Closed].map(|phase| (phase, TreeRecord::None)));",
    "+    let (manifest, records) = progress_prefix(&steps);",
    "+    let tip = check_prefix(&manifest, &records, &sid).unwrap();",
    "+    assert!(tip.terminal_record_only);",
    "+    // Even a complete syntactic chain is pending locator data, not retained",
    "+    // native process/root custody or an adapter ClosedEligibility.",
    "+    println!(\"canonical two-root history required before Ready/Restored; full synthetic Closed prefix remains data-only, no production eligibility\");",
    "+}",
    "+#[test]",
    " fn wl2_r4_tree_progress_refuses_gap_duplicate_wrong_root_and_unfinished_phase() {",
    "     use TreeAction::{CreateWorkingCopy, MoveToCustody, RestoreOriginal};",
    "     use TreeRoot::{Codex, Grok};",
    "diff --git a/test/windows024-native/build-wl2.ps1 b/test/windows024-native/build-wl2.ps1",
    "index 52c2b225c..f1acd27a4 100644",
    "--- a/test/windows024-native/build-wl2.ps1",
    "+++ b/test/windows024-native/build-wl2.ps1",
    "@@ -60,6 +60,7 @@ if($Mode -eq 'sd-stop'){$arguments=@('test','--locked','--offline','--manifest-p",
    " if($Mode -eq 'actual-gui-lib'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','-j','1','windows_owner_host024::','--','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'actual-gui-build'){$arguments=@('build','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--bins','-j','1')}",
    " if($Mode -eq 'actual-gui-observer-build'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--features','custom-protocol','--lib','--no-run','-j','1')}",
    "+if($Mode -eq 'r4-root-progress'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--lib','-j','1','wl2_r4_unperformed','--','--test-threads=1','--nocapture')}",
    " $diff=git diff --binary",
    " if($Mode -eq 'original-reference'){$arguments=@('test','--locked','--offline','--manifest-path','apps/desktop/tauri/Cargo.toml','--target','x86_64-pc-windows-msvc','--lib','-j','1','windows_client_originals024::','--','--test-threads=1','--nocapture')}",
    " if($Mode -eq 'original-move'){"
  ],
