          <mxGeometry x="960" y="130" width="268" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="持久化&lt;br&gt;· manager state：设置与偏好（无明文凭据）&lt;br&gt;· logs：只读、脱敏、可轮转&lt;br&gt;· backups：必须可定位、可校验、可恢复&lt;br&gt;· cache：可随时清空" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="560" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="h5" value="渲染约束&lt;br&gt;· 动作按状态渲染，不渲染无解释的禁用按钮&lt;br&gt;· 界面只用功能名与状态（规划中 / 可用），不出现 P0/P1/P2&lt;br&gt;· WebDAV 卡按连接状态渲染动作组合&lt;br&gt;· 运行 / 连接 / 操作三个维度可同时成立" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="660" y="290" width="600" height="130" as="geometry"/>
