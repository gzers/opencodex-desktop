    "+        assert!(fs::rename(&p, dir.path().join(\"other\")).is_err());",
    "+        assert!(fs::remove_file(&p).is_err());",
    "+        drop(creator);",
    "+        assert!(fs::write(&p, b\"still forbidden while independent reader retained\").is_err());",
    "+        assert_eq!(",
    "+            reader.read().unwrap(),",
    "+            b\"nonsecret locator bound by native peer\"",
    "+        );",
    "+        drop(reader);",
    "+        drop(dir);",
    "+    }",
