(version 1)
(allow default)
(deny network*)
(deny file-read* (require-all (subpath "/Users/ezio") (require-not (subpath "/Users/ezio/WorkSpace/Code/tools/opencodex-desktop/ocx-0219-fixes/apps/desktop/tauri/target/debug/bundle/macos/OpenCodeX Desktop.app"))))
